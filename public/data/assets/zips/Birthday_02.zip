<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
  <meta name="description" content="Responsive Pixstory Laravel Admin Panle">
	<meta name="author" content="Kaushl">
	<meta name="keywords" content="pixstory, pixstory product">

  <title>Pixstory - Laravel Admin Panel</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
  <!-- End fonts -->
  
  <!-- CSRF Token -->
  <meta name="_token" content="wakWFQxZ2OQceRKpa8y4n1qEbq0k4mqrPl6Irbwg">
  
  <link rel="shortcut icon" href="https://pixstory.growwth.in//storage/uploads/setting/7259cd5d-059a-4d1f-aa7c-733bbd7a3295.png">

  <!-- plugin css -->
  <link href="https://pixstory.growwth.in/assets/fonts/feather-font/css/iconfont.css" rel="stylesheet" />
  <link href="https://pixstory.growwth.in/assets/plugins/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" />
  <!-- end plugin css -->

  
  <!-- common css -->
  <link href="https://pixstory.growwth.in/css/app-light.css" rel="stylesheet" />
  <!-- end common css -->

  </head>
<body data-base-url="https://pixstory.growwth.in">

  <script src="https://pixstory.growwth.in/assets/js/spinner.js"></script>

  <div class="main-wrapper" id="app">
    <div class="page-wrapper full-page">
      <div class="page-content d-flex align-items-center justify-content-center">

  <div class="row w-100 mx-0 auth-page">
    <div class="col-md-8 col-xl-6 mx-auto d-flex flex-column align-items-center">
      <img src="https://pixstory.growwth.in/assets/images/others/404.svg" class="img-fluid mb-2" alt="404">
      <h1 class="fw-bolder mb-22 mt-2 tx-80 text-muted">404</h1>
      <h4 class="mb-2">Page Not Found</h4>
      <h6 class="text-muted mb-3 text-center">Oopps!! The page you were looking for doesn't exist.</h6>
      <a href="https://pixstory.growwth.in" class="btn btn-primary">Back to home</a>
    </div>
  </div>

</div>
    </div>
  </div>

    <!-- base js -->
    <script src="https://pixstory.growwth.in/js/app.js"></script>
    <script src="https://pixstory.growwth.in/assets/plugins/feather-icons/feather.min.js"></script>
    <!-- end base js -->

    <!-- plugin js -->
        <!-- end plugin js -->

    <!-- common js -->
    <script src="https://pixstory.growwth.in/assets/js/template.js"></script>
    <!-- end common js -->

    </body>
</html>